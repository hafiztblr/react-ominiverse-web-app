        }
        def Material "CraneMat"
        {
            token outputs:surface.connect = </PortScene/Materials/CraneMat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.62, 0.0)
                float inputs:roughness = 0.38
                float inputs:metallic = 0.55
                token outputs:surface
            }
